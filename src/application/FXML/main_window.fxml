<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox prefWidth="950.0" prefHeight="550.0"
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="application.controller.OverviewController"
    stylesheets="@../css/application.css">

    <!-- Titelleiste -->
    <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="8.0"
        onMousePressed="#onTitlePressed"
        onMouseDragged="#onTitleDragged">

        <Label text="Übersicht Liegeplätze" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="–" onAction="#minimizeWindow" />
        <Button text="□" onAction="#maximizeWindow" />
        <Button text="✕" onAction="#closeWindow" />
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="15.0" right="15.0"
                bottom="15.0" left="15.0" />
        </padding>

        <Pane fx:id="harborPane"
            minWidth="620.0" prefWidth="620.0"
            minHeight="440.0" prefHeight="440.0"
            maxHeight="440.0"
            style="-fx-background-color: #b94720;">

            <Rectangle x="15.0" y="155.0"
                width="605.0" height="145.0"
                fill="#c7dfe8" />

            <!-- Obere Reihe: 5 Liegeplätze -->
            <Button text="1" styleClass="liegeplatz"
                layoutX="15.0" layoutY="30.0"
                prefWidth="110.0" prefHeight="125.0"
                onAction="#openDialog" />

            <Button text="2" styleClass="liegeplatz"
                layoutX="135.0" layoutY="30.0"
                prefWidth="110.0" prefHeight="125.0"
                onAction="#openDialog" />

            <Button text="3" styleClass="liegeplatz"
                layoutX="255.0" layoutY="30.0"
                prefWidth="110.0" prefHeight="125.0"
                onAction="#openDialog" />

            <Button text="4" styleClass="liegeplatz"
                layoutX="375.0" layoutY="30.0"
                prefWidth="110.0" prefHeight="125.0"
                onAction="#openDialog" />

            <Button text="5" styleClass="liegeplatz"
                layoutX="495.0" layoutY="30.0"
                prefWidth="110.0" prefHeight="125.0"
                onAction="#openDialog" />

            <!-- Untere Reihe: 3 breitere Liegeplätze -->
            <Button text="6" styleClass="liegeplatz"
                layoutX="15.0" layoutY="300.0"
                prefWidth="190.0" prefHeight="110.0"
                onAction="#openDialog" />

            <Button text="7" styleClass="liegeplatz"
                layoutX="215.0" layoutY="300.0"
                prefWidth="190.0" prefHeight="110.0"
                onAction="#openDialog" />

            <Button text="8" styleClass="liegeplatz"
                layoutX="415.0" layoutY="300.0"
                prefWidth="190.0" prefHeight="110.0"
                onAction="#openDialog" />
        </Pane>

        <VBox minWidth="260.0" prefWidth="260.0" spacing="20.0">

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Anzahl Liegeplätze:" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="totalCountLabel" text="8" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <CheckBox fx:id="gesperrt"
                    text="Gesperrte Liegeplätze:" selected="true" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="gesperrtCountLabel" text="1" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <CheckBox fx:id="vermietet"
                    text="Vermietete Liegeplätze:" selected="true" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="vermietetCountLabel" text="5" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <CheckBox fx:id="belegt"
                    text="Belegte Liegeplätze:" selected="true" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="belegtCountLabel" text="3" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <CheckBox fx:id="verfuegbar"
                    text="Verfügbare Liegeplätze:" selected="true" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="verfuegbarCountLabel" text="2" />
            </HBox>

            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="closeButton" text="Beenden"
                prefWidth="140.0" onAction="#closeWindow" />
        </VBox>
    </HBox>
</VBox>
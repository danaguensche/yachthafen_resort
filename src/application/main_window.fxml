<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.CheckBox?>

<VBox prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26"
   xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.main_windowController">

   <HBox fx:id="titleBar" onMouseDragged="#onTitleDragged" onMousePressed="#onTitlePressed">

      <Label text="Übersicht Liegeplätze" />

      <Region HBox.hgrow="ALWAYS" />

      <Button onAction="#minimizeWindow" text="–" />
      <Button onAction="#maximizeWindow" text="□" />
      <Button onAction="#closeWindow" text="✕" />
   </HBox>
   <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0" VBox.vgrow="ALWAYS">
      <padding>
         <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
      </padding>
      <children>
         <Pane prefHeight="480.0" prefWidth="650.0" HBox.hgrow="ALWAYS" />
         <VBox prefHeight="200.0" prefWidth="260.0" spacing="20.0">

            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <CheckBox fx:id="locked"
                  text="Gesperrte Liegeplätze:"
                  selected="true" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="lockedCountLabel" text="0" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <CheckBox fx:id="rented"
                  text="Vermietete Liegeplätze:"
                  selected="true" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="rentedCountLabel" text="0" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <CheckBox fx:id="blocked"
                  text="Belegte Liegeplätze:"
                  selected="true" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="blockedCountLabel" text="0" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <CheckBox fx:id="available"
                  text="Verfügbare Liegeplätze:"
                  selected="true" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="availableCountLabel" text="0" />
            </HBox>

            <Button fx:id="closeButton" onAction="#closeWindow" text="Beenden" />

         </VBox>
      </children>
   </HBox>

</VBox>